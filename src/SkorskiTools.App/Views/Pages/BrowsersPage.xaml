<UserControl x:Class="SkorskiTools.App.Views.Pages.BrowsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:controls="clr-namespace:SkorskiTools.App.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900">
    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" />
        <TextBlock Grid.Row="1" Text="{Binding Subtitle}" Style="{StaticResource PageSubtitleStyle}" />

        <Grid Grid.Row="2" Margin="0,12,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="Search browsers..." MinWidth="120"
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox Grid.Column="1" Margin="8,0,0,0" Width="110"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}" />
            <ui:Button Grid.Column="2" Margin="8,0,0,0" Content="Detect"
                       Padding="10,4" FontSize="12"
                       Command="{Binding DetectCommand}" />
            <ui:Button Grid.Column="3" Margin="8,0,0,0" Content="Full install"
                       Appearance="Primary" Padding="10,4" FontSize="12"
                       Command="{Binding RunFullInstallCommand}"
                       Visibility="{Binding IsFullAutoEnabled, Converter={StaticResource BoolToVisibility}}" />
            <ui:Button Grid.Column="4" Margin="8,0,0,0" Content="Simulate"
                       Padding="10,4" FontSize="12"
                       Command="{Binding SimulateCommand}"
                       Visibility="{Binding CanSimulate, Converter={StaticResource BoolToVisibility}}" />
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,0,0,6" Orientation="Horizontal">
            <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                         Visibility="{Binding IsDetecting, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding DetectionSummary}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource SidebarLabelStyle}" />
            <ProgressBar Width="100" Height="4" Margin="10,0,0,0" VerticalAlignment="Center"
                         Value="{Binding FullAutoProgress}" Maximum="{Binding FullAutoTotal}"
                         Visibility="{Binding IsFullAutoRunning, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding FullAutoProgressText}" Margin="8,0,0,0" VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Visibility="{Binding IsFullAutoRunning, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border Grid.Row="4" Margin="0,0,0,8" Padding="14,10" CornerRadius="8"
                BorderThickness="1"
                Visibility="{Binding HasFullAutoResult, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#1A2E7D32" />
                    <Setter Property="BorderBrush" Value="#4CAF50" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FullAutoResultOk}" Value="False">
                            <Setter Property="Background" Value="#1AB71C1C" />
                            <Setter Property="BorderBrush" Value="#F44336" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                <TextBlock Text="{Binding FullAutoResultMessage}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#C8E6C9" TextWrapping="Wrap" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="5">
            <ListBox ItemsSource="{Binding ItemsView}"
                     SelectedItem="{Binding SelectedItem}"
                     ItemTemplate="{StaticResource ApplicationItemTemplate}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            <TextBlock Text="{Binding EmptyMessage}" HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Style="{StaticResource PlaceholderTextStyle}"
                       Visibility="{Binding HasItems, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <controls:ResourceDetailsControl Grid.Row="6" Margin="0,8,0,0" />
    </Grid>
</UserControl>

