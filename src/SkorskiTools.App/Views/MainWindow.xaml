<ui:FluentWindow x:Class="SkorskiTools.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 mc:Ignorable="d"
                 Title="Skorski Tools"
                 Width="1100" Height="640"
                 MinWidth="900" MinHeight="560"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 ExtendsContentIntoTitleBar="True">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Skorski Tools" />

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="252" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Side navigation -->
        <Border Grid.Column="0"
                Background="#08000000"
                BorderBrush="#1FFFFFFF"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="20,22,20,12">
                    <ui:SymbolIcon Symbol="Fluent24" FontSize="26"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="SKORSKI TOOLS" FontSize="14" FontWeight="SemiBold"
                               Margin="0,8,0,0"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="PC setup toolkit" FontSize="11" Margin="0,2,0,0"
                               Style="{StaticResource SidebarLabelStyle}" />
                    <ui:Button Content="Reload catalog" HorizontalAlignment="Stretch" Margin="0,16,0,0"
                               Command="{Binding RefreshCatalogCommand}" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,10,0,0"
                               Style="{StaticResource SidebarLabelStyle}" />
                    <TextBlock Text="{Binding VersionText}" Margin="0,4,0,0"
                               Style="{StaticResource SidebarLabelStyle}" />
                </StackPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavigationListBoxItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal"
                                        AutomationProperties.Name="{Binding Title}">
                                <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="18" Width="22"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Active section -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" />
        </Grid>
    </Grid>
</ui:FluentWindow>
