<UserControl x:Class="SkorskiTools.App.Views.Controls.ResourceDetailsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="420" d:DesignWidth="330">
    <Border Padding="12,10" CornerRadius="8" Background="#0BFFFFFF"
            BorderBrush="#14FFFFFF" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Selected resource" Grid.ColumnSpan="2" FontSize="13" FontWeight="SemiBold"
                       Margin="0,0,0,10"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <TextBlock Text="Name" Style="{StaticResource SidebarLabelStyle}" Grid.Row="1" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.Title}" FontSize="13"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,2,0,8">
                <TextBlock Text="{Binding SelectedItem.StatusText}" FontSize="11"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding SelectedItem.DetectionSource}" FontSize="10"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <TextBlock Text="Category" Style="{StaticResource SidebarLabelStyle}" Grid.Row="3" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.CategoryName}" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <TextBlock Text="Id" Style="{StaticResource SidebarLabelStyle}" Grid.Row="4" />
            <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Id}" FontSize="12"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <!-- The note owns a full row so it can wrap without overlapping metadata. -->
            <TextBlock Text="Install note" Style="{StaticResource SidebarLabelStyle}" Grid.Row="5"
                       VerticalAlignment="Top"
                       Visibility="{Binding SelectedItem.HasInstallNote, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.InstallNote}" FontSize="12"
                       TextWrapping="Wrap" Foreground="#FFD47A"
                       Visibility="{Binding SelectedItem.HasInstallNote, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="Files" Style="{StaticResource SidebarLabelStyle}" Grid.Row="6"
                       VerticalAlignment="Top" />
            <StackPanel Grid.Row="6" Grid.Column="1">
                <TextBlock Text="{Binding SelectedItem.DetailsText}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{Binding SelectedItem.ManifestPath}" FontSize="10" TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <TextBlock Text="Why it's useful" Style="{StaticResource SidebarLabelStyle}" Grid.Row="7"
                       VerticalAlignment="Top" />
            <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedItem.HighlightsText}" FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Border>
</UserControl>
