<Application x:Class="SkorskiTools.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:viewmodels="clr-namespace:SkorskiTools.App.ViewModels.Pages"
             xmlns:pages="clr-namespace:SkorskiTools.App.Views.Pages"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
                <pages:DashboardPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ApplicationsViewModel}">
                <pages:ApplicationsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:BrowsersViewModel}">
                <pages:BrowsersPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:PortablesViewModel}">
                <pages:PortablesPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:AuxiliaryViewModel}">
                <pages:AuxiliaryPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ScriptsViewModel}">
                <pages:ScriptsPage />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
                <pages:SettingsPage />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
