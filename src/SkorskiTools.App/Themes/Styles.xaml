<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:vm="clr-namespace:SkorskiTools.App.ViewModels"
                    xmlns:converters="clr-namespace:SkorskiTools.App.Converters">

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- Shared typography for section pages. -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="InfoPanelStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Background" Value="#0FFFFFFF" />
        <Setter Property="BorderBrush" Value="#1FFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="PlaceholderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="SidebarLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <!-- Side navigation item appearance. -->
    <Style x:Key="NavigationListBoxItemStyle" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="10,7"
                            Margin="10,1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#12FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A compact catalog row, shared by all resource sections. -->
    <DataTemplate x:Key="ResourceItemTemplate" DataType="{x:Type vm:ResourceItemViewModel}">
        <Border Padding="14,10" Margin="0,0,0,6" CornerRadius="8"
                Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Image Source="{Binding IconPath}" Width="32" Height="32"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="26"
                                   Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding FilesText}" FontSize="11" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CategoryName}" FontSize="11" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding Version}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Application/browser row with the three installation actions. -->
    <DataTemplate x:Key="ApplicationItemTemplate" DataType="{x:Type vm:ResourceItemViewModel}">
        <Border Padding="14,10" Margin="0,0,0,6" CornerRadius="8"
                Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" VerticalAlignment="Center">
                    <Image Source="{Binding IconPath}" Width="32" Height="32"
                           Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                    <ui:SymbolIcon Symbol="{Binding Glyph}" FontSize="26"
                                   Visibility="{Binding HasNoIcon, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,3,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Content="Install" Margin="0,0,4,0" Padding="8,4" FontSize="12"
                               Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               CommandParameter="{Binding}"
                               Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                    <ui:Button Content="Uninstall" Margin="0,0,4,0" Padding="8,4" FontSize="12"
                               IsEnabled="{Binding CanUninstall}"
                               Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               CommandParameter="{Binding}" />
                    <ui:Button Content="Reinstall" Padding="8,4" FontSize="12"
                               IsEnabled="{Binding CanReinstall}"
                               Command="{Binding DataContext.ReinstallCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Auxiliary row: only a Download button; files are never executed. -->
    <DataTemplate x:Key="AuxiliaryItemTemplate" DataType="{x:Type vm:ResourceItemViewModel}">
        <Border Padding="14,10" Margin="0,0,0,6" CornerRadius="8"
                Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Glyph}" FontSize="26"
                               VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{Binding FilesText}" FontSize="11" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <ui:Button Content="Download" Padding="8,4" FontSize="12"
                               Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               CommandParameter="{Binding}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Script row: copy icon on the right, no execution control. -->
    <DataTemplate x:Key="ScriptItemTemplate" DataType="{x:Type vm:ResourceItemViewModel}">
        <Border Padding="14,10" Margin="0,0,0,6" CornerRadius="8"
                Background="#0FFFFFFF" BorderBrush="#14FFFFFF" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="{Binding Glyph}" FontSize="26"
                               VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Margin="8,0,12,0">
                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="{Binding Description}" FontSize="12"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1AFFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Border>
                    <ui:Button Padding="8,4" FontSize="12"
                               ToolTip="Copy script to clipboard"
                               Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               CommandParameter="{Binding}">
                        <ui:SymbolIcon Symbol="Copy24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
