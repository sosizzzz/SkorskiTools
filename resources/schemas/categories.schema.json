{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skorski.tools/schemas/categories.schema.json",
  "title": "Categories",
  "type": "object",
  "required": ["categories"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "icon": { "type": "string" }
        }
      }
    }
  }
}
